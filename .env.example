# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=codemind_password
MYSQL_DATABASE=codemind

# LLM provider. Use an OpenAI-compatible API when possible.
LLM_API_KEY=your_llm_api_key
LLM_BASE_URL=https://api.example.com/v1
LLM_MODEL=your_chat_model
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=1
LLM_MAX_TOKENS=1200
CHAT_TOTAL_TIMEOUT_SECONDS=60
# Qwen3.5/Qwen3.6 automatically use non-thinking mode when this is unset.
# Set it explicitly only when the selected provider supports the parameter.
# LLM_ENABLE_THINKING=false
LLM_THINKING_BUDGET=512

# Encrypts user-provided LLM API keys at rest. Generate a separate random
# secret of at least 32 characters and never commit the real value.
LLM_CONFIG_ENCRYPTION_KEY=replace_with_a_separate_random_secret_at_least_32_chars
LLM_CONFIG_MAX_PRESETS=5
LLM_CONFIG_TEST_COOLDOWN_SECONDS=30
LLM_CONFIG_TEST_TIMEOUT_SECONDS=30
# Comma-separated exact hostnames permitted for personal "OpenAI compatible" presets.
LLM_OPENAI_COMPATIBLE_ALLOWED_HOSTS=
# Development only: allow DNS results in Clash's 198.18.0.0/15 fake-IP range.
LLM_ALLOW_PROXY_FAKE_IP=false

# Mind-map generation favors bounded, structured output. Leave the model empty
# to reuse LLM_MODEL. Disabling thinking avoids spending the token budget on
# hidden reasoning before the JSON response.
MIND_MAP_MODEL=
MIND_MAP_TIMEOUT_SECONDS=600
# Hard wall-clock limit for each model call, including a structured-output retry.
# Keep the finite default in production. Setting 0 explicitly disables this guard and can
# let a trickling upstream response occupy one of the three global mind-map LLM slots forever.
MIND_MAP_TOTAL_TIMEOUT_SECONDS=900
MIND_MAP_MAX_RETRIES=0
MIND_MAP_ENABLE_THINKING=false
MIND_MAP_BATCH_MAX_TOKENS=1600
MIND_MAP_MERGE_MAX_TOKENS=4096
MIND_MAP_RETRY_MAX_TOKENS=6400

# Embedding provider. Required: the system does not provide local fallback vectors.
EMBEDDING_API_KEY=your_embedding_api_key
EMBEDDING_BASE_URL=https://api.example.com/v1
EMBEDDING_MODEL=your_embedding_model
EMBEDDING_TIMEOUT_SECONDS=30
EMBEDDING_MAX_RETRIES=1
# Tuned for Qwen/Qwen3-VL-Embedding-8B (4096 dimensions). Re-evaluate this
# value whenever the embedding model or dimension changes.
RETRIEVAL_SCORE_THRESHOLD=0.45

# Persistent document ingestion workers
DOCUMENT_WORKER_CONCURRENCY=2

# Vector store
CHROMA_PERSIST_DIR=storage/chroma

# Backend
BACKEND_CORS_ORIGINS=http://localhost:5173

# JWT authentication. Replace with a long random value in backend/.env.
JWT_SECRET_KEY=change-me-before-enabling-auth
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=180

# Frontend
VITE_API_BASE_URL=http://localhost:8000

